# syntax=docker/dockerfile:1
#
# 源码全量构建镜像（自包含,无需预编译二进制）:前端构建 → Go 编译 → 运行时。
# 与根目录 Dockerfile 的关系:那个是"预编译二进制 + 工具层"的打包镜像(CI 用);
# 这个是给用户 docker compose build 从源码一步出镜像用的,最终工具层与之一致。
#
# 构建(国内网络建议先给 Docker 配代理或改用镜像站):
#   docker compose build    # compose 已指向本文件

# ---------- ① 前端静态导出 ----------
FROM node:22-alpine AS fe
# 可选构建参数:国内构建用镜像源,默认官方源
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm config set registry "$NPM_REGISTRY" && npm ci
COPY web/ ./
RUN npm run build:static

# ---------- ② Go 编译(内嵌前端) ----------
FROM golang:1.26-alpine AS gobuild
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN mkdir -p server/webui/dist
COPY --from=fe /src/web/out/ server/webui/dist/
# CGO_ENABLED=0 纯静态产物,alpine(musl)构建的二进制在 bookworm 运行时同样可跑
RUN CGO_ENABLED=0 go build -tags embedui -trimpath -ldflags "-s -w" -o /out/artex ./cmd/artex

# ---------- ③ 运行时(与 Dockerfile 工具层一致) ----------
FROM python:3.12-slim-bookworm
# 可选构建参数:APT 镜像站(默认官方 deb.debian.org;国内可传 mirrors.aliyun.com 或 mirrors.ustc.edu.cn)
ARG APT_MIRROR=
ARG NPM_REGISTRY=https://registry.npmjs.org
# Node 安装源:默认 nodejs.org 官方 tarball;国内可传 https://registry.npmmirror.com/-/binary/node
# (NodeSource 可变脚本方案废弃——它是第三方管道执行且国内不可达;改为官方 tarball + SHASUMS256 校验)
ARG NODE_DIST_BASE=https://nodejs.org/dist
ARG NODE_VERSION=22.14.0
# Playwright 浏览器下载源:默认官方 CDN;国内可传 https://registry.npmmirror.com/-/binary/playwright
ARG PLAYWRIGHT_DOWNLOAD_HOST=
# 分层注意:每层独立 RUN,某层失败重试时前面的层仍吃缓存
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|deb.debian.org|${APT_MIRROR}|g; s|security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ripgrep curl wget vim git jq unzip \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && rm -rf /var/lib/apt/lists/*
# Node:官方 tarball + 同源 SHASUMS256 校验(fail-closed;校验文件里的相对路径
# 按 CWD 解析,所以统一下载到 /tmp 并在 /tmp 下校验;用 .tar.gz 变体——slim 基础
# 镜像不带 xz-utils)
RUN set -e; \
    cd /tmp; \
    curl -fsSL -o "node-v${NODE_VERSION}-linux-x64.tar.gz" "${NODE_DIST_BASE}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz"; \
    curl -fsSL "${NODE_DIST_BASE}/v${NODE_VERSION}/SHASUMS256.txt" \
      | grep "node-v${NODE_VERSION}-linux-x64.tar.gz" | sha256sum -c -; \
    tar -xzf "node-v${NODE_VERSION}-linux-x64.tar.gz" -C /usr/local --strip-components=1; \
    rm -f "node-v${NODE_VERSION}-linux-x64.tar.gz"
# Playwright MCP/CLI + chromium(--with-deps 内部还会跑 apt,APT_MIRROR 已生效)
RUN npm config set registry "$NPM_REGISTRY" \
    && npm install -g @playwright/mcp@0.0.80 @playwright/cli@0.1.19 playwright@1.63.0 \
    && playwright-cli --help \
    && if [ -n "$PLAYWRIGHT_DOWNLOAD_HOST" ]; then \
         PLAYWRIGHT_DOWNLOAD_HOST="$PLAYWRIGHT_DOWNLOAD_HOST" playwright install --with-deps chromium; \
       else \
         playwright install --with-deps chromium; \
       fi \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=gobuild /out/artex /app/artex
COPY start.sh /app/start.sh
RUN chmod +x /app/artex /app/start.sh
COPY skills/ /app/skills/
VOLUME ["/app/data"]
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
